# Development image with hot-reload
FROM golang:1.25.5

WORKDIR /app

# Install air for hot-reloading
RUN go install github.com/air-verse/air@latest

# Copy source so go mod tidy can detect imports (volume overwrites at runtime)
COPY go.mod go.sum ./
RUN go mod download

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]